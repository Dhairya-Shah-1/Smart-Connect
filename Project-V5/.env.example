VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Public Render service URL, without /predict (for example https://your-service.onrender.com)
VITE_INCIDENT_AI_URL=https://your-service.onrender.com
# Required for the local /api/verify-incident bridge and Vercel deployment.
GEMINI_API_KEY=your-gemini-api-key
# Required by the Super Admin "Manage Admins -> + Add Admin" flow (/api/manage-admin).
# SECRET: server-side only, never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
