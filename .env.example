# Frontend (safe to expose, read by Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server/API routes (Vercel functions and the local dev middleware).
# Never prefix these with VITE_ and never expose the service-role key in browser code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional locally; required in Vercel for /api/upload-evidence and reliable /api/verify-incident saves.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Deployed YOLO model (frontend and serverless routes use it directly; no key needed)
# https://smartconnect-api.onrender.com
